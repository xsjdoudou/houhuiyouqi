<view class="page">
  <view class="top"><view class="brand"><text class="brand-mark">友</text><text>后会友期</text></view><text class="top-note">MEET YOU AGAIN</text></view>

  <view wx:if="{{view === 'home'}}" class="home">
    <view class="eyebrow"><text class="dot"></text> 关于相遇，也关于你</view>
    <view class="hero-title">你的相处方式，<br/>像哪位嘉宾？</view>
    <view class="hero-copy">从重逢、沟通到和解，<br/>看看八位嘉宾中，谁与你的相处方式更相似。</view>
    <view class="art" aria-hidden="true">
      <view class="art-caption">FRIENDSHIP<br/>IS A JOURNEY</view>
      <view class="art-quote">相遇之后，<br/>总有新的故事。</view>
      <view class="art-bottom"><text>一份关于友谊的探索</text><text>01 — 08</text></view>
    </view>
    <view class="details"><text>16 道题目</text><text class="detail-divider"></text><text>约 3 分钟</text><text class="detail-divider"></text><text>8 位嘉宾</text></view>
    <button class="primary" bindtap="start">开始探索 <text class="arrow">→</text></button>
    <button class="text-button" bindtap="history">我的测试记录 <text>↗</text></button>
    <view class="disclaimer">基于节目公开呈现的趣味联想，非官方测评，不代表嘉宾真实性格。</view>
  </view>

  <view wx:elif="{{view === 'quiz'}}" class="quiz">
    <view class="quiz-meta"><text>你的友谊探索</text><text><text class="current-number">{{index + 1}}</text> / {{questions.length}}</text></view>
    <view class="progress"><view class="progress-fill" style="width: {{progress}}%"></view></view>
    <view class="question-label">QUESTION <text class="question-number">{{index + 1}}</text></view>
    <view class="question-title">{{questions[index].title}}</view>
    <view class="question-hint">选择更接近你的一个答案</view>
    <view class="options">
      <button wx:for="{{questions[index].options}}" wx:key="index" class="option {{selected === index ? 'option-selected' : ''}}" data-value="{{index}}" bindtap="select">
        <text class="option-letter">{{index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D'}}</text><text class="option-text">{{item}}</text><text class="option-check {{selected === index ? 'checked' : ''}}">{{selected === index ? '✓' : ''}}</text>
      </button>
    </view>
    <button class="primary" bindtap="next" disabled="{{selected < 0 || loading}}">{{index === questions.length - 1 ? '查看我的结果' : '下一题'}} <text class="arrow">→</text></button>
    <button wx:if="{{index > 0}}" class="text-button" bindtap="previous">← 上一题</button>
    <button wx:else class="text-button" bindtap="home">返回首页</button>
  </view>

  <view wx:elif="{{view === 'result'}}" class="result">
    <view class="eyebrow"><text class="dot"></text> {{shared ? '一份来自朋友的分享' : '你的匹配结果'}} </view>
    <view class="result-intro">{{shared ? 'TA 的相处方式像' : '你的相处方式像'}}</view>
    <view class="result-name" style="color: {{result.color}}">{{result.name}}</view>
    <view class="result-tag">{{result.tag}}</view>
    <view class="result-art" style="background: {{result.color}}"><view class="result-art-label">A LITTLE MORE ABOUT YOU</view><view class="result-art-title">每一种相处，<br/>都有自己的温度。</view><view class="result-art-footer">后会友期 <text>MEET YOU AGAIN</text></view></view>
    <view class="section-label">ABOUT {{shared ? 'THEM' : 'YOU'}}</view>
    <view class="section-title">关于{{shared ? 'TA' : '你'}}</view>
    <view class="body-copy">{{result.description}}</view>
    <view class="advice"><view class="advice-title">给{{shared ? 'TA' : '你'}}的小建议</view><view>{{result.advice}}</view></view>
    <view wx:if="{{saveMessage}}" class="save-message">{{saveMessage}}</view>
    <button wx:if="{{!shared}}" class="primary" open-type="share">分享我的结果 <text class="arrow">↗</text></button>
    <button wx:else class="primary" bindtap="start">测测我的友谊人格 <text class="arrow">→</text></button>
    <button class="text-button" bindtap="home">返回首页</button>
    <view class="disclaimer">基于节目公开呈现的趣味联想，非官方测评，不代表嘉宾真实性格。</view>
  </view>

  <view wx:else class="history">
    <view class="eyebrow"><text class="dot"></text> YOUR JOURNEY</view>
    <view class="page-title">我的测试记录</view>
    <view class="history-subtitle">每一次探索，都是一次新的认识。</view>
    <view wx:if="{{loading}}" class="empty">正在加载...</view>
    <view wx:elif="{{historyError}}" class="empty"><view>记录暂时无法加载</view><button class="retry" bindtap="history">重新加载</button></view>
    <view wx:elif="{{records.length === 0}}" class="empty">还没有测试记录，去认识一下自己吧。</view>
    <view wx:else class="record-list">
      <view wx:for="{{records}}" wx:key="id" class="record">
        <view class="record-main" data-type="{{item.type}}" bindtap="openRecord"><view class="record-name">{{item.name}}</view><view class="record-date">{{item.date}}</view></view>
        <button class="delete" data-id="{{item.id}}" bindtap="deleteRecord">删除</button>
      </view>
    </view>
    <button class="primary" bindtap="start">开始新的测试 <text class="arrow">→</text></button>
    <button class="text-button" bindtap="home">返回首页</button>
  </view>
</view>
